# ==============================================================================
# AlNadary Smart ERP — Branch Local Edge Server Configuration (.env.edge)
# Copy this file to .env.edge and fill in the secrets (NEVER commit .env.edge)
# ==============================================================================

# Edge HTTP Server (LAN + localhost)
EDGE_PORT=8787
EDGE_HOST=0.0.0.0

# Company & Branch Identity (Branch B1: فرع وائل النظاري)
COMPANY_ID=7f3a9c21-5b4e-4d8a-9e12-6c0d3b8a5f47
BRANCH_ID=d8771318-20f8-4260-9ac6-e40c3378a5e1
BRANCH_CODE=B1
BRANCH_NAME=فرع وائل النظاري

# Supabase Cloud Primary Connection
SUPABASE_URL=https://dagfjncoullstrhbjssr.supabase.co
SUPABASE_ANON_KEY=
# Optional: only needed for headless automated background sync/backups when no browser user is logged in
SUPABASE_SERVICE_ROLE_KEY=

# Local Storage & Backup Directories
DATA_DIR=C:\AlNadary_Edge\B1\data
BACKUP_DIR=C:\AlNadary_Backups
DIST_DIR=..\dist

# Intervals & Retention
SYNC_INTERVAL_MS=120000
BACKUP_CRON_HOUR=23
BACKUP_CRON_MINUTE=30
BACKUP_RETENTION_DAYS=30

# Google Drive Automated Backups (OAuth Refresh Token — run `npm run setup-gdrive`)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_NAME=AlNadary_ERP_Backups
